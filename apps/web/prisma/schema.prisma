// Real Estate Platform - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
}

enum ListingStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model User {
  sentInquiries Inquiry[] @relation("InquirySender")
  receivedInquiries Inquiry[] @relation("InquiryRecipient")
  reviews ListingReview[]
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(USER)

  listings     Listing[]
  favorites    Favorite[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Listing {
  inquiries Inquiry[]
  reviews ListingReview[]
  id           String        @id @default(cuid())
  title        String        @db.VarChar(120)
  description  String        @db.Text
  listingType  ListingType
  propertyType PropertyType
  status       ListingStatus @default(PENDING)

  price        Decimal       @db.Decimal(14, 2)
  currency     String        @default("RUB") @db.VarChar(3)
  area         Decimal       @db.Decimal(10, 2)
  rooms        Int?
  floor        Int?
  totalFloors  Int?

  city         String        @db.VarChar(100)
  address      String?       @db.VarChar(300)
  latitude     Float?
  longitude    Float?

  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  images       ListingImage[]
  favorites    Favorite[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([city, status])
  @@index([listingType, propertyType, status])
  @@index([price])
  @@index([ownerId])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String   @db.VarChar(2048)
  sortOrder Int      @default(0)

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId, sortOrder])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}


enum ReviewDecision {
  PUBLISHED
  REJECTED
}

model ListingReview {
  id         String         @id @default(cuid())
  listingId  String
  reviewerId String?
  decision   ReviewDecision
  reason     String?        @db.VarChar(1000)
  createdAt  DateTime       @default(now())

  listing    Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([reviewerId])
}


model Inquiry {
  id          String   @id @default(cuid())
  listingId   String
  senderId    String
  recipientId String
  message     String   @db.VarChar(2000)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender    User    @relation("InquirySender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User    @relation("InquiryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([listingId])
}

// Shared PostgreSQL-backed API rate-limit buckets.
model RateLimitBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
