eta b{display:grid;place-items:center;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#147d69;color:white;font-size:9px}.hm-messenger-no-threads{padding:20px;color:#80909e;font-size:12px;text-align:center}.hm-messenger-active-chat{min-width:0}.hm-messenger-active-chat .hm-chat-header{margin-bottom:12px}.hm-messenger-active-chat .hm-chat-messages{min-height:400px;max-height:calc(100vh - 360px)}
 @media(max-width:850px){.hm-messenger-layout{grid-template-columns:minmax(0,1fr);min-height:0}.hm-messenger-sidebar{display:none}.hm-messenger-active-chat .hm-chat-messages{max-height:62vh;min-height:280px}.hm-chat-breadcrumb{display:flex}}
+
+
+/* Messenger UX V3: property-first identity and reliable blocking route */
+.hm-conversation-avatar,.hm-messenger-thread-avatar{overflow:hidden;position:relative;background:#e2f3eb;color:#147d69}
+.hm-conversation-avatar img,.hm-messenger-thread-avatar img{display:block;width:100%;height:100%;object-fit:cover}
+.hm-conversation-avatar span,.hm-messenger-thread-avatar>span{display:grid;width:100%;height:100%;place-items:center;font-size:24px;font-weight:950}
+.hm-chat-property-header{align-items:center;justify-content:space-between;gap:18px}
+.hm-chat-property-identity{display:flex;align-items:center;gap:14px;min-width:0;flex:1;color:inherit;text-decoration:none}
+.hm-chat-property-identity>img,.hm-chat-property-placeholder{display:grid;width:76px;height:70px;flex:0 0 76px;place-items:center;object-fit:cover;border-radius:15px;background:#e2f3eb;color:#147d69;font-size:32px}
+.hm-chat-property-copy{display:flex;min-width:0;flex-direction:column;gap:4px}
+.hm-chat-property-copy>small{color:#147d69;font-size:10px;font-weight:900}
+.hm-chat-property-copy h1{overflow:hidden;margin:0;color:#173b5b;font-size:clamp(16px,2vw,21px);font-weight:950;text-overflow:ellipsis;white-space:nowrap}
+.hm-chat-property-copy>span{color:#7c8c99;font-size:11px}
+.hm-chat-counterpart{display:flex;align-items:center;gap:10px;min-width:150px;padding:10px 12px;border:1px solid #e2eaf0;border-radius:14px;background:#f8fbfc}
+.hm-chat-counterpart-dot{width:9px;height:9px;flex:0 0 9px;border-radius:50%;background:#15956e;box-shadow:0 0 0 4px #15956e18}
+.hm-chat-counterpart>span:last-child{display:flex;min-width:0;flex-direction:column;gap:3px}
+.hm-chat-counterpart small,.hm-chat-counterpart em{color:#82919d;font-size:9px;font-style:normal}
+.hm-chat-counterpart strong{overflow:hidden;color:#173b5b;font-size:12px;text-overflow:ellipsis;white-space:nowrap}
+@media(max-width:640px){.hm-chat-property-header{align-items:stretch;gap:12px;padding:15px}.hm-chat-property-identity>img,.hm-chat-property-placeholder{width:62px;height:60px;flex-basis:62px}.hm-chat-counterpart{min-width:0}.hm-chat-property-copy h1{white-space:normal}}
