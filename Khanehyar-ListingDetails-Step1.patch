diff --git a/apps/web/app/listings/[id]/detail.css b/apps/web/app/listings/[id]/detail.css
index 5bc4239..07a1afe 100644
--- a/apps/web/app/listings/[id]/detail.css
+++ b/apps/web/app/listings/[id]/detail.css
@@ -1122,3 +1122,31 @@
 @media (prefers-reduced-motion: reduce) {
   .hd-gallery-image, .hd-similar-card { transition: none !important; }
 }
+
+
+/* Step 1: international-quality property details additions */
+.hd-detail-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0;
+  margin: 0;
+  border: 1px solid var(--hd-border);
+  border-radius: 16px;
+  overflow: hidden;
+}
+.hd-detail-item { min-width: 0; padding: 14px 16px; border-bottom: 1px solid var(--hd-border); }
+.hd-detail-item:nth-child(odd) { border-inline-end: 1px solid var(--hd-border); }
+.hd-detail-item dt { color: var(--hd-muted); font-size: 12px; }
+.hd-detail-item dd { margin: 4px 0 0; color: var(--hd-navy); font-size: 14px; font-weight: 850; overflow-wrap: anywhere; }
+.hd-amenities { margin-top: 20px; }
+.hd-amenities h3 { margin: 0 0 12px; color: var(--hd-navy); font-size: 15px; }
+.hd-amenities ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
+.hd-amenities li { display: flex; align-items: center; gap: 8px; color: #40556b; font-size: 13px; }
+.hd-amenities li span { display: inline-grid; place-items: center; flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%; background: #e5f5ee; color: #147d69; font-weight: 900; }
+.hd-conversion-note { margin: 8px 0; padding: 10px 12px; border-radius: 10px; background: #f0f7ff; color: #365b7e; font-size: 12px; }
+.hd-owner-avatar-image { width: 58px; height: 58px; flex: 0 0 58px; border-radius: 50%; object-fit: cover; border: 2px solid #e3eee9; }
+@media (max-width: 700px) {
+  .hd-detail-grid { grid-template-columns: 1fr; }
+  .hd-detail-item:nth-child(odd) { border-inline-end: 0; }
+  .hd-amenities ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
